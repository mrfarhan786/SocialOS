{
  "format-on-write": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/scripts/format-on-write.sh",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "destructive-command-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/scripts/safety-gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
